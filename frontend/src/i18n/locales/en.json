  "privacyPage": {
    "title": "Privacy Policy",
    "operator": {
      "title": "Operator",
      "body": "FloorForge is self-hosted software. The operator of this instance is the administrator who set up this server — not the developers of the software. All data remains exclusively on this server; no data is transferred to third parties."
    },
    "dataCategories": {
      "title": "What data is stored?",
      "account": "Account: email address, display name, password (encrypted hash), role",
      "boards": "Boards: names, notes, frames (positions/formations), attacking/defensive lines",
      "settings": "Settings: display and accessibility preferences"
    },
    "purpose": {
      "title": "Purpose & retention period",
      "body": "This data is used solely to provide the app's functionality (tactics board, board management). It is stored for as long as your account exists and is fully deleted from the active database as soon as you delete your account (Settings → Account → Delete account). If the operator has enabled automatic backups, your data may still be contained in already-created backup archives until the configured retention period (max. 90 days) expires."
    },
    "rights": {
      "title": "Your rights",
      "intro": "At any time, in Settings (the \"Data\" section), you can:",
      "accessTitle": "Access",
      "accessBody": "(Art. 15 GDPR) – view all stored data directly",
      "exportTitle": "Export",
      "exportBody": "(Art. 20 GDPR) – download all data as a ZIP file",
      "rectifyTitle": "Rectify",
      "rectifyBody": "(Art. 16 GDPR) – change your name, email, and password at any time",
      "deleteTitle": "Delete",
      "deleteBody": "(Art. 17 GDPR) – permanently remove your account and all associated data"
    },
    "shareLinkNotice": {
      "title": "Share links",
      "body": "If you create a share link for a board, the board name along with all frames/positions and formations can be viewed through it without logging in — no account data is included. Share links automatically expire after a limited time and become invalid afterward."
    },
    "noThirdParty": {
      "title": "No third parties, no tracking",
      "body": "FloorForge does not integrate any external analytics or tracking services. No data is shared with third parties. The only cookie used is a technically necessary, httpOnly-secured session cookie for login."
    },
    "security": {
      "title": "Security",
      "body": "The database is only reachable within the internal Docker network, not from outside. For accessing this app over the internet, we recommend running it behind a reverse proxy with HTTPS. Access logs do not contain full IP addresses (anonymized)."
    }
  },
