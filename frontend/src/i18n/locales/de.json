  "privacyPage": {
    "title": "Datenschutzerklärung",
    "operator": {
      "title": "Betreiber",
      "body": "FloorForge ist selbst gehostete Software. Betreiber dieser Instanz ist der Administrator, der diesen Server eingerichtet hat – nicht die Entwickler der Software. Alle Daten verbleiben ausschließlich auf diesem Server; es findet keine Übertragung an Dritte statt."
    },
    "dataCategories": {
      "title": "Welche Daten werden gespeichert?",
      "account": "Konto: E-Mail-Adresse, Anzeigename, Passwort (verschlüsselt gehasht), Rolle",
      "boards": "Spielfelder: Namen, Notizen, Frames (Positionen/Formationen), Sturm-/Defensivreihen",
      "settings": "Einstellungen: Darstellungs- und Barrierefreiheits-Präferenzen"
    },
    "purpose": {
      "title": "Zweck & Speicherdauer",
      "body": "Die Daten dienen ausschließlich der Bereitstellung der App-Funktionalität (Taktiktafel, Spielfeld-Verwaltung). Sie werden gespeichert, solange dein Konto besteht, und aus der aktiven Datenbank vollständig gelöscht, sobald du dein Konto löschst (Einstellungen → Konto → Account löschen). Sofern der Betreiber automatische Backups aktiviert hat, können deine Daten in bereits erstellten Backup-Archiven noch bis zum Ablauf der eingestellten Aufbewahrungsfrist (max. 90 Tage) enthalten sein."
    },
    "rights": {
      "title": "Deine Rechte",
      "intro": "Du kannst jederzeit in den Einstellungen (Bereich „Daten“):",
      "accessTitle": "Einsehen",
      "accessBody": "(Art. 15 DSGVO) – alle gespeicherten Daten direkt anzeigen lassen",
      "exportTitle": "Exportieren",
      "exportBody": "(Art. 20 DSGVO) – alle Daten als ZIP herunterladen",
      "rectifyTitle": "Berichtigen",
      "rectifyBody": "(Art. 16 DSGVO) – Name, E-Mail und Passwort jederzeit ändern",
      "deleteTitle": "Löschen",
      "deleteBody": "(Art. 17 DSGVO) – Konto samt aller Daten unwiderruflich entfernen"
    },
    "shareLinkNotice": {
      "title": "Share-Links",
      "body": "Erstellst du einen Share-Link zu einem Spielfeld, sind darüber ohne Login der Spielname sowie alle Frames/Positionen und Formationen einsehbar – keine Kontodaten. Share-Links laufen automatisch nach einer begrenzten Zeit ab und werden danach ungültig."
    },
    "noThirdParty": {
      "title": "Keine Drittanbieter, kein Tracking",
      "body": "FloorForge bindet keine externen Analyse- oder Tracking-Dienste ein. Es werden keine Daten an Dritte weitergegeben. Das einzige Cookie ist ein technisch notwendiges, httpOnly-gesichertes Sitzungs-Cookie zur Anmeldung."
    },
    "security": {
      "title": "Sicherheit",
      "body": "Die Datenbank ist nur innerhalb des internen Docker-Netzwerks erreichbar, nicht von außen. Für den Zugriff auf diese App über das Internet wird der Betrieb hinter einem Reverse-Proxy mit HTTPS empfohlen. Zugriffs-Logs enthalten keine vollständigen IP-Adressen (anonymisiert)."
    }
  },
