# ================================================
# FloorForge – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
# NIEMALS .env in Git committen!
# ================================================

# ── App ──────────────────────────────────────────
# Port auf dem die App erreichbar ist (Host)
APP_PORT=80

# Node-Umgebung: development | production | test
NODE_ENV=production

# ── Datenbank (PostgreSQL) ────────────────────────
# Name der Datenbank
DB_NAME=floorforge

# Benutzername für die Datenbank
DB_USER=floorforge

# SICHERES Passwort – min. 20 Zeichen, zufällig generiert empfohlen
# Beispiel: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────
# SICHERES Passwort für Redis
# Beispiel: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────
# Geheimer Schlüssel für JWT-Signierung – min. 64 Zeichen
# Beispiel: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_SECRET_KEY_MIN_64_CHARS

# JWT Gültigkeit (z.B. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────
# Erlaubte Origin für CORS (Frontend-URL)
# Produktiv: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ── bcrypt ────────────────────────────────────────
# Anzahl der bcrypt Runden (mindestens 12)
BCRYPT_ROUNDS=12

# ── Frontend Build ────────────────────────────────
# API-URL für das Frontend (im Container: /api via Nginx-Proxy)
VITE_API_URL=/api
