# ================================================
# OpenFloorball – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
# NIEMALS .env in Git committen!
# ================================================

# ── App ──────────────────────────────────────────
# Port auf dem die App erreichbar ist (Host)
APP_PORT=80

# Node-Umgebung: development | production | test
NODE_ENV=production

# ── Datenbank (PostgreSQL) ────────────────────────
# Name der Datenbank
DB_NAME=openfloorball

# Benutzername für die Datenbank
DB_USER=openfloorball

# SICHERES Passwort – min. 20 Zeichen, zufällig generiert empfohlen
# Beispiel: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────
# SICHERES Passwort für Redis
# Beispiel: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────
# Geheimer Schlüssel für JWT-Signierung – min. 64 Zeichen
# Beispiel: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_SECRET_KEY_MIN_64_CHARS

# JWT Gültigkeit (z.B. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────
# Erlaubte Origin für CORS (Frontend-URL)
# Produktiv: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ── bcrypt ────────────────────────────────────────
# Anzahl der bcrypt Runden (mindestens 12)
BCRYPT_ROUNDS=12

# ── Cookies ───────────────────────────────────────
# Session-Cookie nur über HTTPS senden (true = empfohlen, sobald ein
# TLS-Reverse-Proxy davorsteht). Läuft die Instanz ohne HTTPS (z.B. reines
# HTTP im Heimnetz), MUSS dies auf false stehen – sonst verwirft der Browser
# das Login-Cookie sofort.
COOKIE_SECURE=true

# ── Share-Links ───────────────────────────────────
# Gültigkeitsdauer öffentlicher Share-Links (Spielzug ohne Login ansehen)
SHARE_LINK_EXPIRES_HOURS=72

# ── E-Mail (SMTP, optional) ───────────────────────
# Wird genutzt, um einen Nutzer per Mail zu benachrichtigen, wenn er als
# Kollaborator zu einem Board hinzugefügt wird (Issue #51). Komplett
# optional – ohne SMTP_HOST bleibt die App voll funktionsfähig, es wird
# nur keine Mail verschickt.
#
# Beispiel Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=deine-adresse@gmail.com, SMTP_PASSWORD=ein App-Passwort
# (https://myaccount.google.com/apppasswords) – das normale Google-Konto-
# Passwort funktioniert wegen 2FA i.d.R. nicht direkt.
SMTP_HOST=
SMTP_PORT=587
# true nur bei Port 465 (implizites TLS), sonst false (Port 587 = STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenFloorball <noreply@example.com>

# ── Frontend Build ────────────────────────────────
# API-URL für das Frontend (im Container: /api via Nginx-Proxy)
VITE_API_URL=/api
