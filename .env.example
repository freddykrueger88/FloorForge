# FloorForge – Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an!

# App
APP_PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# Sicherheit (UNBEDINGT ändern!)
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_EXPIRES_IN=7d

# Datenbank (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=floorforge
DB_USER=floorforge
DB_PASSWORD=CHANGE_ME_SECURE_DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Upload & Export
UPLOAD_MAX_SIZE=50mb
EXPORT_DIR=/app/exports
SHARE_LINK_EXPIRES_HOURS=72

# CORS (Komma-getrennt)
CORS_ORIGINS=http://localhost:3000
